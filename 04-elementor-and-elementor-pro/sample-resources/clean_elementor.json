[{"id": "c6b2748", "elType": "container", "settings": {"content_width": "full"}, "elements": [{"id": "858d03e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<style>\n.av-lead-box{background:linear-gradient(135deg,#f8fafc 0%,#edf2f7 100%);border:1px solid #e2e8f0;border-radius:16px;padding:24px;margin-bottom:24px;box-shadow:0 4px 20px rgba(0,0,0,0.03)}\n.av-lead-text{font-size:1.15rem;line-height:1.9;color:#1e293b;font-weight:600;margin-bottom:18px;text-align:justify}\n.av-inner-box{background:#fff;border-radius:12px;padding:18px;border-right:4px solid #0284c7;margin-bottom:18px}\n.av-cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}\n.av-cat-pill{background:#f8fafc;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;font-weight:600;color:#334155;display:flex;align-items:center}\n.av-num-badge{background:#0284c7;color:#fff;width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:12px;margin-left:8px;flex-shrink:0}\n.av-highlight-banner{background:rgba(2,132,199,0.08);border-radius:12px;padding:14px 18px;color:#0369a1;font-weight:600;font-size:0.98rem;line-height:1.8}\n.av-section-title{color:#0f172a;font-size:1.5rem;margin-top:35px;margin-bottom:16px;border-bottom:2px solid #e2e8f0;padding-bottom:10px}\n.av-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:22px 0;border-radius:14px;box-shadow:0 4px 15px rgba(0,0,0,0.04);border:1px solid #e2e8f0}\n.av-table{width:100%;border-collapse:collapse;text-align:center;min-width:600px;font-size:0.98rem;background:#fff}\n.av-table th{background:#1e293b;color:#fff;padding:14px 16px;border:1px solid #334155}\n.av-table td{padding:12px 14px;border:1px solid #e2e8f0}\n.av-table tr:nth-child(even){background:#f8fafc}\n.av-sport-col{font-weight:bold;color:#0284c7}\n.av-strength-pill{background:#dcfce7;color:#15803d;padding:4px 8px;border-radius:6px;font-weight:600;display:inline-block}\n.av-stat-card{background:linear-gradient(135deg,#fef2f2 0%,#fee2e2 100%);border:1px solid #fecaca;border-radius:14px;padding:20px;margin:25px 0;display:flex;align-items:center;gap:16px}\n.av-stat-icon{background:#ef4444;color:#fff;width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}\n.av-img-card{text-align:center;margin:25px 0}\n.av-img-card img{max-width:100%;height:auto;border-radius:16px;box-shadow:0 6px 25px rgba(0,0,0,0.08);border:1px solid #e2e8f0}\n.av-img-caption{font-size:0.9rem;color:#64748b;margin-top:8px}\n.av-color-dot{display:inline-block;width:12px;height:12px;border-radius:50%;margin-left:6px;vertical-align:middle}\n.av-model-card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:22px;margin-bottom:20px;box-shadow:0 4px 15px rgba(0,0,0,0.03)}\n.av-model-card-featured{background:#fff;border:2px solid #0284c7;border-radius:16px;padding:24px;margin-bottom:20px;box-shadow:0 6px 20px rgba(2,132,199,0.08)}\n.av-model-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:12px;gap:8px}\n.av-model-title{margin:0;color:#0f172a;font-size:1.25rem;font-weight:bold}\n.av-model-badge{background:#e0f2fe;color:#0369a1;padding:4px 12px;border-radius:20px;font-size:0.82rem;font-weight:bold}\n.av-check-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;background:#f8fafc;border-radius:10px;padding:14px;margin-top:12px}\n.av-check-item{display:flex;align-items:center;color:#334155;font-size:0.93rem}\n.av-check-icon{color:#10b981;font-weight:bold;margin-left:8px;flex-shrink:0}\n.av-heritage-card{background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);color:#fff;border-radius:20px;padding:30px;margin:30px 0;box-shadow:0 10px 30px rgba(15,23,42,0.2)}\n.av-service-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:25px 0}\n.av-service-item{background:rgba(255,255,255,0.06);padding:12px 16px;border-radius:10px;border:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;font-size:0.95rem}\n.av-cta-btn{display:inline-block;background:#0284c7;color:#fff!important;padding:13px 32px;border-radius:30px;font-weight:bold;font-size:1.02rem;text-decoration:none;box-shadow:0 4px 15px rgba(2,132,199,0.4)}\n.av-summary-box{background:linear-gradient(135deg,#f0fdf4 0%,#dcfce7 100%);border:1px solid #bbf7d0;border-radius:16px;padding:26px;margin:30px 0}\n.av-carousel-header{margin:35px 0 15px 0;text-align:center}\n</style>\n<div class=\"av-lead-box\">\n    <p class=\"av-lead-text\">\n        با انواع عینک ورزشی آشنا شوید: دورپیچ، یک تکه، گاگل ایمنی، اسکی، شنا و طبی. ببینید کدام مدل برای ورزش و نمره چشم شما مناسب تر است.\n    </p>\n    <div class=\"av-inner-box\">\n        <h4 style=\"color:#0f172a;margin-top:0;margin-bottom:12px;font-size:1.05rem;\">انواع عینک ورزشی بر اساس مدل و طراحی به ۷ دسته اصلی تقسیم می‌شوند:</h4>\n        <div class=\"av-cat-grid\">\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۱</span> عینک ورزشی دورپیچ</div>\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۲</span> عینک یک تکه (شیلد)</div>\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۳</span> عینک نیم‌فریم و بدون‌فریم</div>\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۴</span> گاگل ایمنی توپی و راکتی</div>\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۵</span> گاگل اسکی و اسنوبرد</div>\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۶</span> گاگل شنا و واترپلو</div>\n            <div class=\"av-cat-pill\"><span class=\"av-num-badge\">۷</span> عینک ورزشی طبی و نمره‌دار</div>\n        </div>\n    </div>\n    <div class=\"av-highlight-banner\">\n        💡 هر مدل برای ورزش، شرایط نوری و نیاز بینایی متفاوتی ساخته شده است: \n        <strong>دورپیچ برای دویدن و دوچرخه‌سواری</strong>، \n        <strong>گاگل ایمنی برای بسکتبال و اسکواش</strong>، \n        و <strong>مدل طبی برای کسانی که نمره دارند</strong> و نمی‌خواهند بین دید شفاف و آزادی حرکت یکی را فدا کنند.\n    </div>\n</div>\n"}, "elements": []}, {"id": "425b68a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<h2 class=\"av-section-title\">کدام مدل برای کدام ورزش؟</h2>\n<p style=\"color:#475569;font-size:1.05rem;line-height:1.8;\">اگر ورزش مشخصی دارید و فقط می‌خواهید سریع بدانید کدام مدل برایش ساخته شده، جدول راهنمای زیر مسیر انتخاب را کوتاه می‌کند:</p>\n<div class=\"av-table-wrap\">\n    <table class=\"av-table\">\n        <thead>\n            <tr><th>ورزش</th><th>مدل پیشنهادی</th><th>عدسی مناسب</th></tr>\n        </thead>\n        <tbody>\n            <tr><td class=\"av-sport-col\">دویدن</td><td>دورپیچ، یک تکه یا نیم فریم</td><td>خاکستری یا فتوکرومیک</td></tr>\n            <tr><td class=\"av-sport-col\">دوچرخه سواری</td><td>دورپیچ یا یک تکه (شیلد)</td><td>عدسی تعویض‌پذیر یا فتوکرومیک</td></tr>\n            <tr><td class=\"av-sport-col\">بسکتبال و اسکواش</td><td>گاگل ایمنی</td><td>پلی‌کربنات شفاف نشکن</td></tr>\n            <tr><td class=\"av-sport-col\">تنیس و والیبال</td><td>گاگل ایمنی یا دورپیچ ایمنی</td><td>پلی‌کربنات، شفاف یا رنگ ملایم</td></tr>\n            <tr><td class=\"av-sport-col\">اسکی و اسنوبرد</td><td>گاگل اسکی</td><td>عدسی رنگی ضدبخار متناسب با نور برف</td></tr>\n            <tr><td class=\"av-sport-col\">شنا و واترپلو</td><td>گاگل شنا</td><td>ضدبخار و آب‌بند سیلیکونی</td></tr>\n            <tr><td class=\"av-sport-col\">ورزش با نمره چشم</td><td>عینک ورزشی طبی</td><td>پلی‌کربنات نمره‌دار ضدشکنندگی</td></tr>\n        </tbody>\n    </table>\n</div>\n<div style=\"background:#fffbeb;border-right:4px solid #f59e0b;border-radius:12px;padding:16px 20px;margin-top:20px;\">\n    <h4 style=\"color:#b45309;margin:0 0 8px 0;font-size:1.05rem;\">📌 نکته‌ای که در این جدول پنهان است:</h4>\n    <ul style=\"margin:0;padding-right:20px;color:#78350f;line-height:1.8;\">\n        <li>برای ورزش‌های پربرخورد توپ، راکت یا آرنج، <strong>«ایمنی» مقدم بر «ظاهر» است</strong>.</li>\n        <li>در دویدن و دوچرخه‌سواری، اولویت اصلی با <strong>میدان دید باز و محافظت در برابر باد، گردوغبار و اشعه خورشید</strong> است.</li>\n    </ul>\n</div>\n"}, "elements": []}, {"id": "58818e3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<h2 class=\"av-section-title\">مقایسه سریع انواع عینک ورزشی</h2>\n<p style=\"color:#475569;font-size:1.05rem;line-height:1.8;\">پیش از ورود به جزئیات فنی، جدول زیر تفاوت‌های اصلی و نقاط قوت این ۷ مدل را در یک نگاه نشان می‌دهد:</p>\n<div class=\"av-table-wrap\">\n    <table class=\"av-table\" style=\"min-width:720px;\">\n        <thead>\n            <tr><th>مدل</th><th>طراحی فریم</th><th>مناسب‌ترین ورزش‌ها</th><th>نقطه قوت اصلی</th><th>محدودیت</th></tr>\n        </thead>\n        <tbody>\n            <tr><td class=\"av-sport-col\">دورپیچ</td><td>قاب خمیده با دو عدسی</td><td>دویدن، دوچرخه‌سواری، گلف</td><td><span class=\"av-strength-pill\">محافظت جانبی باد و غبار</span></td><td style=\"color:#64748b;\">وزن کمی بیشتر از مدل‌های ساده</td></tr>\n            <tr><td class=\"av-sport-col\">یک تکه (شیلد)</td><td>یک عدسی پهن و پیوسته</td><td>دوچرخه‌سواری، دویدن مسیر باز</td><td><span class=\"av-strength-pill\">میدان دید پانوراما و وسیع</span></td><td style=\"color:#64748b;\">کمتر مناسب صورت‌های بسیار کوچک</td></tr>\n            <tr><td class=\"av-sport-col\">نیم‌فریم و بدون‌فریم</td><td>قاب سبک بدون لبه زیرین</td><td>دویدن، پیاده‌روی سریع</td><td><span class=\"av-strength-pill\">حداکثر سبکی و دید باز</span></td><td style=\"color:#64748b;\">محافظت جانبی کمتر در ضربه</td></tr>\n            <tr><td class=\"av-sport-col\">گاگل ایمنی</td><td>قاب محکم با بند سر</td><td>بسکتبال، اسکواش، تنیس</td><td><span class=\"av-strength-pill\">مقاومت فوق‌العاده در ضربه</span></td><td style=\"color:#64748b;\">تهویه کمتر در ورزش طولانی گرم</td></tr>\n            <tr><td class=\"av-sport-col\">گاگل اسکی</td><td>عدسی پهن با اسفنج آب‌بند</td><td>اسکی، اسنوبرد</td><td><span class=\"av-strength-pill\">سد کامل باد، برف و UV</span></td><td style=\"color:#64748b;\">نیاز به تهویه برای ضدبخار</td></tr>\n            <tr><td class=\"av-sport-col\">گاگل شنا</td><td>آب‌بند سیلیکونی، عدسی ضدبخار</td><td>شنا و واترپلو</td><td><span class=\"av-strength-pill\">آب‌بندی ۱۰۰٪ و دید زیر آب</span></td><td style=\"color:#64748b;\">مخصوص محیط‌های آبی</td></tr>\n            <tr><td class=\"av-sport-col\">طبی ورزشی</td><td>فریم ورزشی با عدسی نمره‌دار</td><td>همه ورزش‌ها با نمره چشم</td><td><span class=\"av-strength-pill\">دید کاملاً دقیق + ایمنی کامل</span></td><td style=\"color:#64748b;\">نیاز به نسخه و ساخت اختصاصی</td></tr>\n        </tbody>\n    </table>\n</div>\n<div class=\"av-stat-card\">\n    <div class=\"av-stat-icon\">⚠️</div>\n    <div>\n        <h4 class=\"av-stat-title\">اهمیت انتخاب درست فقط راحتی نیست؛ حفظ سلامت بینایی است!</h4>\n        <p class=\"av-stat-desc\">بر اساس اعلام <strong>آکادمی چشم پزشکی آمریکا (AAO)</strong>، سالانه نزدیک به <strong>۳۰ هزار نفر</strong> به دلیل آسیب‌های چشمی ورزشی به اورژانس مراجعه می‌کنند؛ در حالی که <strong>بیش از ۹۰٪ این آسیب‌ها با عینک محافظ ورزشی استاندارد کاملاً قابل پیشگیری بوده‌اند.</strong></p>\n    </div>\n</div>\n"}, "elements": []}, {"id": "ffd8997", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<h2 class=\"av-section-title\">چطور رنگ و جنس عدسی ورزشی را انتخاب کنیم؟</h2>\n<div class=\"av-img-card\">\n    <img src=\"https://wpvision.ir/wp-content/uploads/2026/11/sports-glasses-lens-colors.webp\" alt=\"راهنمای انتخاب رنگ و جنس عدسی عینک ورزشی\" width=\"1536\" height=\"1024\" />\n    <p class=\"av-img-caption\">راهنمای بصری انتخاب رنگ و خصوصیات نوری عدسی در انواع عینک ورزشی</p>\n</div>\n<p style=\"color:#475569;font-size:1.05rem;line-height:1.8;\">رنگ عدسی بر کنتراست تصویر، میزان عبور نور و تشخیص عمق میدان اثر مستقیم دارد. جدول زیر کاربرد هر رنگ را مشخص می‌کند:</p>\n<div class=\"av-table-wrap\">\n    <table class=\"av-table\">\n        <thead>\n            <tr><th>رنگ عدسی</th><th>بهترین شرایط محیطی</th><th>ویژگی و مزیت اصلی</th></tr>\n        </thead>\n        <tbody>\n            <tr><td style=\"font-weight:bold;\"><span class=\"av-color-dot\" style=\"background:#475569;\"></span>خاکستری</td><td>نور شدید و آفتاب مستقیم</td><td>حفظ کامل رنگ‌های طبیعی بدون تغییر تناژ</td></tr>\n            <tr><td style=\"font-weight:bold;\"><span class=\"av-color-dot\" style=\"background:#b45309;\"></span>قهوه‌ای و کهربایی</td><td>هوای ابری یا نور متغیر و سایه</td><td>افزایش کنتراست و تشخیص پستی‌بلندی‌ها</td></tr>\n            <tr><td style=\"font-weight:bold;\"><span class=\"av-color-dot\" style=\"background:#eab308;\"></span>زرد</td><td>نور کم، گرگ‌ومیش و مه</td><td>رساندن حداکثر روشنایی و وضوح به چشم</td></tr>\n            <tr><td style=\"font-weight:bold;\"><span class=\"av-color-dot\" style=\"background:#cbd5e1;border:1px solid #94a3b8;\"></span>شفاف (Clear)</td><td>ورزش‌های سالنی، شب و تاریکی</td><td>حفاظت فیزیکی کامل بدون تغییر شدت نور</td></tr>\n            <tr><td style=\"font-weight:bold;\"><span class=\"av-color-dot\" style=\"background:#0ea5e9;\"></span>آینه‌ای (Iridium)</td><td>نور بسیار شدید و بازتاب برف/آب</td><td>بازتاب حداکثری پرتوها و رفع خستگی چشم</td></tr>\n            <tr><td style=\"font-weight:bold;\"><span class=\"av-color-dot\" style=\"background:linear-gradient(45deg,#cbd5e1,#1e293b);\"></span>فتوکرومیک</td><td>مسیرهای متغیر، جنگلی و طلوع/غروب</td><td>تغییر خودکار تیرگی با شدت پرتوهای فرابنفش</td></tr>\n        </tbody>\n    </table>\n</div>\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin:25px 0;\">\n    <div style=\"background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:18px;\">\n        <h4 style=\"margin:0 0 8px 0;color:#166534;font-size:1.05rem;\">🌤️ سازگاری با شرایط نور متغیر</h4>\n        <p style=\"margin:0;color:#14532d;font-size:0.95rem;line-height:1.8;\">در مسیرهایی با سایه و آفتاب مداوم (مانند کوهستان)، <strong>عدسی فتوکرومیک</strong> بیشترین راحتی را دارد؛ اما برای نور ثابت، یک عدسی با رنگ ثابت گزینه‌ای سبک‌تر و اقتصادی‌تر است.</p>\n    </div>\n    <div style=\"background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:18px;\">\n        <h4 style=\"margin:0 0 8px 0;color:#991b1b;font-size:1.05rem;\">🛡️ اهمیت تضمین اصالت کالا</h4>\n        <p style=\"margin:0;color:#7f1d1d;font-size:0.95rem;line-height:1.8;\"><a href=\"https://armanivision.com/sports/\" style=\"color:#b91c1c;font-weight:bold;text-decoration:underline;\">عینک ورزشی اورجینال</a> از نظر مقاومت در ضربه، فیلتراسیون واقعی UV400 و کیفیت نوری زایس، تفاوتی اساسی با نمونه‌های تقلبی شکننده دارد.</p>\n    </div>\n</div>\n"}, "elements": []}, {"id": "c2bfabc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<div class=\"av-carousel-header\">\n    <span style=\"background:#e0f2fe;color:#0284c7;padding:5px 16px;border-radius:20px;font-size:0.85rem;font-weight:bold;\">پیشنهاد فروشگاه</span>\n    <h3 style=\"color:#0f172a;font-size:1.4rem;margin:10px 0 4px 0;\">محبوب‌ترین عینک‌های ورزشی و دوچرخه‌سواری</h3>\n    <p style=\"color:#64748b;font-size:0.95rem;margin:0;\">فریم‌های یک‌تکه و دورپیچ مقاوم در برابر باد و اشعه فرابنفش</p>\n</div>\n"}, "elements": []}, {"id": "43c87da", "elType": "widget", "widgetType": "wd_products", "settings": {"layout": "carousel", "spacing": "30", "hide_pagination_control": "yes", "hide_prev_next_buttons": "", "wrap": "yes", "scroll_carousel_init": "yes", "stretch_product": "1", "stretch_product_mobile": "1", "products_with_background": "1", "products_background": "#F1F1F1", "products_color_scheme": "dark", "product_quantity": "disable", "title_color": "#412E27", "slides_per_view_mobile": {"unit": "px", "size": 2, "sizes": []}, "slides_per_view_tablet": {"unit": "px", "size": 3, "sizes": []}, "autoplay": "yes", "speed": 3000, "taxonomies": ["1893"], "include": [], "custom_css": ".product-element-bottom{text-align:center;}.value{text-align:center;}"}, "elements": []}, {"id": "48d8ae1", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<h2 class=\"av-section-title\">بررسی دقیق ۷ مدل عینک ورزشی بر اساس نیاز شما</h2>\n\n<!-- Model 1 -->\n<div class=\"av-model-card\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\">۱. عینک ورزشی دورپیچ (Wraparound)</h3>\n        <span class=\"av-model-badge\">انتخاب اول دوندگان و دوچرخه‌سواران</span>\n    </div>\n    <p style=\"color:#475569;line-height:1.8;margin:0 0 14px 0;\">اگر بیشتر در فضای باز ورزش می‌کنید (دویدن، دوچرخه‌سواری یا گلف) و به محافظت در برابر باد، گردوغبار و نورهای جانبی نیاز دارید، دورپیچ بهترین استایل برای شماست.</p>\n    <div class=\"av-check-grid\">\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> قاب خمیده هماهنگ با انحنای سر برای پوشش جانبی</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> پد بینی و دسته‌های لاستیکی ضدلغزش و ضدتعریق</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> عدسی پلی‌کربنات بسیار سبک و نشکن</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> امکان استفاده با عدسی‌های فتوکرومیک و پلاریزه</div>\n    </div>\n</div>\n\n<!-- Model 2 -->\n<div class=\"av-model-card\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\">۲. عینک ورزشی یک تکه یا شیلد (Shield)</h3>\n        <span class=\"av-model-badge\">میدان دید ۳۶۰ درجه بدون مرز</span>\n    </div>\n    <p style=\"color:#475569;line-height:1.8;margin:0 0 14px 0;\">اگر مسیرهای باز را با سرعت بالا طی می‌کنید و نیازمند هوشیاری نسبت به محیط پیرامون هستید، مدل یک‌تکه با حذف پل میانی، دیدی پانوراما و یکدست مهیا می‌سازد.</p>\n    <div class=\"av-check-grid\">\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> عدسی پیوسته پهن با میدان دید افقی و عمودی گسترده</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> طراحی بدون حاشیه میانی برای تمرکز بی‌وقفه</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> بسیار محبوب برای مسابقات دوچرخه‌سواری سرعت</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> شیارهای تهویه آیرودینامیک برای مهار بخار</div>\n    </div>\n</div>\n"}, "elements": []}, {"id": "a0e4881", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<!-- Model 3 -->\n<div class=\"av-model-card\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\">۳. عینک نیم‌فریم و بدون‌فریم (Semi-Rimless)</h3>\n        <span class=\"av-model-badge\" style=\"background:#f1f5f9;color:#475569;\">سبک‌ترین حالت ممکن بر روی چهره</span>\n    </div>\n    <p style=\"color:#475569;line-height:1.8;margin:0 0 14px 0;\">برای فعالیت‌هایی که سبکی و آزادی حرکت اولویت دارد (مثل دویدن استقامتی و پیاده‌روی سریع)، مدل‌های نیم‌فریم کمترین حس وجود را ایجاد می‌کنند.</p>\n    <div class=\"av-check-grid\">\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> وزن بسیار کم و عدم ایجاد احساس سنگینی روی بینی</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> دید باز رو به پایین بدون مانع لبه قاب</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> طراحی شیک، مینیمال و ارگونومیک</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> ایده‌آل برای تمرینات روتین هوازی</div>\n    </div>\n</div>\n\n<!-- Model 4 -->\n<div class=\"av-model-card\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\">۴. گاگل ایمنی ورزش‌های توپی و راکتی</h3>\n        <span class=\"av-model-badge\" style=\"background:#fee2e2;color:#991b1b;\">سپر دفاعی چشم در برابر ضربه</span>\n    </div>\n    <p style=\"color:#475569;line-height:1.8;margin:0 0 14px 0;\">در ورزش‌هایی مثل بسکتبال، اسکواش، تنیس و والیبال که خطر اصابت توپ، راکت یا برخورد دست وجود دارد، استفاده از گاگل بنددار ضروری است.</p>\n    <div class=\"av-check-grid\">\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> عدسی فوق‌العاده مقاوم پلی‌کربنات یا ترایوکس نشکن</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> لایه‌های لاستیکی ضربه‌گیر روی بینی و شقیقه‌ها</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> بند سر کشی قابل رگلاژ برای ثبات در پرش‌ها</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> دارای تاییدیه استاندارد جهانی ASTM F803</div>\n    </div>\n</div>\n\n<!-- Model 5 -->\n<div class=\"av-model-card\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\">۵. گاگل اسکی و اسنوبرد</h3>\n        <span class=\"av-model-badge\" style=\"background:#eff6ff;color:#1d4ed8;\">محافظ چشم در ارتفاع و برف</span>\n    </div>\n    <p style=\"color:#475569;line-height:1.8;margin:0 0 14px 0;\">انعکاس شدید خورشید روی برف و بادهای سرد ارتفاعات نیازمند عینک‌های پوشاننده کامل با اسفنج متراکم ضدسوز است.</p>\n    <div class=\"av-check-grid\">\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> عدسی دوجداره ضدبخار با فیلتر ۱۰۰٪ UV400</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> فوم آب‌بند برای سد کامل باد، سرما و برف</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> تنوع رنگ عدسی متناسب با شرایط نوری کوهستان</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> مطابق استانداردهای معتبر EN 174 و ISO 18527-1</div>\n    </div>\n</div>\n\n<!-- Model 6 -->\n<div class=\"av-model-card\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\">۶. گاگل شنا و واترپلو</h3>\n        <span class=\"av-model-badge\" style=\"background:#f0fdfa;color:#0f766e;\">آب‌بندی بی‌نقص و دید زیر آب</span>\n    </div>\n    <p style=\"color:#475569;line-height:1.8;margin:0 0 14px 0;\">گاگل شنا با لبه‌های سیلیکونی محافظتی، مانع نفوذ کلر و آب به چشم شده و دید واضحی برای شناگران فراهم می‌کند.</p>\n    <div class=\"av-check-grid\">\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> واشر سیلیکونی منعطف برای آب‌بندی بدون فشار دردناک</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> پوشش درونی ضدبخار (Anti-Fog) پایدار</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> مدل‌های آینه‌ای ضد UV مخصوص استخرهای روباز</div>\n        <div class=\"av-check-item\"><span class=\"av-check-icon\">✔</span> بند دوتایی قابل تنظیم بر اساس فرم سر</div>\n    </div>\n</div>\n\n<!-- Model 7 -->\n<div class=\"av-model-card-featured\">\n    <div class=\"av-model-header\">\n        <h3 class=\"av-model-title\" style=\"color:#0284c7;\">۷. عینک ورزشی طبی و نمره‌دار</h3>\n        <span class=\"av-model-badge\" style=\"background:#0284c7;color:#fff;\">دید کاملاً دقیق بدون خطر افتادن لنز</span>\n    </div>\n    <p style=\"color:#334155;line-height:1.8;margin:0 0 16px 0;\">اگر چشمان شما نمره دارد و نمی‌خواهید نگران جابه‌جایی لنز یا خشکی چشم حین وزش باد باشید، عینک ورزشی طبی ایمنی فریم ورزشی را با دقت نسخه شما ترکیب می‌کند.</p>\n    <div style=\"background:#f0f9ff;border-radius:12px;padding:18px;border-right:4px solid #0284c7;\">\n        <h4 style=\"color:#0369a1;margin:0 0 12px 0;font-size:1.05rem;\">چرا عینک طبی ورزشی بسیار بهتر از لنز تماسی است؟</h4>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;\">\n            <div style=\"background:#fff;padding:12px;border-radius:8px;border:1px solid #bae6fd;\"><strong>🛡️ ایمنی در ضربه:</strong> لنز تماسی هیچ محافظتی در برابر ضربه توپ ندارد.</div>\n            <div style=\"background:#fff;padding:12px;border-radius:8px;border:1px solid #bae6fd;\"><strong>🎯 اصلاح همزمان:</strong> عدسی پلی‌کربنات نمره‌دار هم دید تیز می‌دهد و هم نشکن است.</div>\n            <div style=\"background:#fff;padding:12px;border-radius:8px;border:1px solid #bae6fd;\"><strong>🏃 ثبات در حرکت:</strong> پدها و دسته‌های ضدلغزش مانع افتادن عینک حین جهش‌ها می‌شوند.</div>\n            <div style=\"background:#fff;padding:12px;border-radius:8px;border:1px solid #bae6fd;\"><strong>🕶️ تنوع عدسی:</strong> قابلیت سفارش با پوشش فتوکرومیک، پلاریزه یا رنگ دلخواه.</div>\n        </div>\n    </div>\n</div>\n"}, "elements": []}, {"id": "39dbbc4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<div class=\"av-carousel-header\">\n    <span style=\"background:#f0fdf4;color:#166534;padding:5px 16px;border-radius:20px;font-size:0.85rem;font-weight:bold;\">کالکشن کامل</span>\n    <h3 style=\"color:#0f172a;font-size:1.4rem;margin:10px 0 4px 0;\">خرید جدیدترین مدل‌های عینک ورزشی اورجینال</h3>\n    <p style=\"color:#64748b;font-size:0.95rem;margin:0;\">تضمین ۱۰۰٪ اصالت کالا و امکان تراش و ساخت عدسی طبی نمره‌دار در آرمانی ویژن</p>\n</div>\n"}, "elements": []}, {"id": "1c2bb78", "elType": "widget", "widgetType": "wd_products", "settings": {"layout": "carousel", "spacing": "30", "hide_pagination_control": "yes", "hide_prev_next_buttons": "", "wrap": "yes", "scroll_carousel_init": "yes", "stretch_product": "1", "stretch_product_mobile": "1", "products_with_background": "1", "products_background": "#F1F1F1", "products_color_scheme": "dark", "product_quantity": "disable", "title_color": "#412E27", "slides_per_view_mobile": {"unit": "px", "size": 2, "sizes": []}, "slides_per_view_tablet": {"unit": "px", "size": 3, "sizes": []}, "autoplay": "yes", "speed": 3000, "taxonomies": ["23"], "include": [], "custom_css": ".product-element-bottom{text-align:center;}.value{text-align:center;}"}, "elements": []}, {"id": "e1eb35a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<h2 class=\"av-section-title\">نکات مهم قبل از انتخاب عینک ورزشی</h2>\n<div class=\"av-img-card\">\n    <img src=\"https://wpvision.ir/wp-content/uploads/2026/11/sports-glasses-buying-guide.webp\" alt=\"نکات مهم قبل از خرید و انتخاب عینک ورزشی\" width=\"1536\" height=\"1024\" />\n    <p class=\"av-img-caption\">مشاوره تخصصی و تطبیق عینک با نوع ورزش و نسخه چشم در آرمانی ویژن</p>\n</div>\n<p style=\"color:#475569;font-size:1.05rem;line-height:1.8;\">عینک ورزشی ابزاری است که باید همزمان ایمنی و راحتی بدهد؛ و ترکیب این دو، نیازمند دانش تخصصی و تجربه در صنعت اپتیک است.</p>\n\n<div class=\"av-heritage-card\">\n    <div style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;border-bottom:1px solid rgba(255,255,255,0.15);padding-bottom:18px;margin-bottom:20px;gap:12px;\">\n        <div>\n            <span style=\"background:#0284c7;color:#fff;padding:4px 12px;border-radius:12px;font-size:0.8rem;font-weight:bold;\">پیشرو در صنعت اپتیک ایران</span>\n            <h3 style=\"margin:10px 0 0 0;color:#fff;font-size:1.45rem;\">مجموعه آرمانی ویژن (ادامه‌دهنده راه عینک نور رشت)</h3>\n        </div>\n        <div style=\"background:rgba(255,255,255,0.1);padding:8px 16px;border-radius:12px;text-align:center;border:1px solid rgba(255,255,255,0.2);\">\n            <span style=\"font-size:1.5rem;font-weight:bold;color:#38bdf8;\">۶۰+ سال</span>\n            <div style=\"font-size:0.8rem;color:#cbd5e1;\">تجربه تخصصی از سال ۱۳۴۶</div>\n        </div>\n    </div>\n    <p style=\"color:#cbd5e1;line-height:1.9;font-size:1.02rem;margin-bottom:20px;text-align:justify;\">\n        تجربه بیش از ۶ دهه، تضمین قطعی اصالت کالا، لابراتوار مجهز نصب عدسی با ماشین‌آلات زایس (Zeiss) آلمان و مشاوره رایگان اپتومتریست‌ها به شما اطمینان می‌دهد که مدلی کاملاً سازگار با ورزش و نسخه چشمتان دریافت کنید.\n    </p>\n    <div class=\"av-service-grid\">\n        <div class=\"av-service-item\"><span style=\"color:#38bdf8;font-size:1.2rem;margin-left:10px;\">🎧</span> مشاوره تخصصی رایگان پیش از خرید</div>\n        <div class=\"av-service-item\"><span style=\"color:#38bdf8;font-size:1.2rem;margin-left:10px;\">🔬</span> تراش و نصب رایگان عدسی با تجهیزات زایس</div>\n        <div class=\"av-service-item\"><span style=\"color:#38bdf8;font-size:1.2rem;margin-left:10px;\">📦</span> ارسال اکسپرس و رایگان به سراسر کشور</div>\n        <div class=\"av-service-item\"><span style=\"color:#38bdf8;font-size:1.2rem;margin-left:10px;\">📋</span> راهنمای انتخاب عدسی بر اساس نسخه شما</div>\n        <div class=\"av-service-item\"><span style=\"color:#38bdf8;font-size:1.2rem;margin-left:10px;\">🗓️</span> پشتیبانی تخصصی ۷ روز هفته</div>\n    </div>\n    <div style=\"text-align:center;\">\n        <a href=\"https://armanivision.com/sports/\" class=\"av-cta-btn\">مشاهده کالکشن و خرید عینک ورزشی اصل ←</a>\n    </div>\n</div>\n"}, "elements": []}, {"id": "aadaecc", "elType": "container", "settings": {"content_width": "full"}, "elements": [{"id": "d94ee9e", "elType": "widget", "widgetType": "heading", "settings": {"title": "سوالات متداول درباره خرید و انتخاب انواع عینک ورزشی", "header_size": "h3"}, "elements": []}, {"id": "c0101a2", "elType": "widget", "widgetType": "nested-accordion", "settings": {"items": [{"item_title": "آیا می‌توان برای هر ورزشی عینک طبی نمره‌دار تهیه کرد؟", "_id": "cabceb3"}, {"item_title": "برای دوچرخه‌سواری عدسی فتوکرومیک بهتر است یا چند عدسی تعویض‌پذیر؟", "_id": "653df0d"}, {"item_title": "تفاوت اصلی گاگل ایمنی با عینک آفتابی معمولی در چیست؟", "_id": "e91f448"}, {"item_title": "چگونه از بخار گرفتن عدسی عینک حین تعریق زیاد جلوگیری کنیم؟", "_id": "ea61ffb"}], "accordion_item_title_space_between": {"unit": "px", "size": 6, "sizes": []}}, "elements": [{"id": "903ef48", "elType": "container", "settings": {"_title": "آیا می‌توان برای هر ورزشی عینک طبی نمره‌دار تهیه کرد؟", "content_width": "full"}, "elements": [{"id": "cdc12cf", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align:justify;\">بله، اغلب فریم‌های ورزشی استاندارد قابلیت نصب عدسی‌های طبی نمره‌دار را دارند. عدسی‌های مورد استفاده باید حتماً از جنس پلی‌کربنات یا ترایوکس نشکن باشند. برای نمره‌های بالا یا فریم‌های بسیار خمیده نیز از کلیپس‌های نمره‌دار (Optical Insert) داخل فریم استفاده می‌شود.</p>"}, "elements": []}]}, {"id": "437f2fa", "elType": "container", "settings": {"_title": "برای دوچرخه‌سواری عدسی فتوکرومیک بهتر است یا چند عدسی تعویض‌پذیر؟", "content_width": "full"}, "elements": [{"id": "0a6fd26", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align:justify;\">عدسی فتوکرومیک برای مسیرهایی با تغییر مداوم نور (سایه درختان و آفتاب مستقیم) بسیار راحت‌تر است چون نیاز به توقف و تعویض ندارد. اما عدسی‌های تعویض‌پذیر برای شرایط خاص مثل شب (عدسی شفاف) یا مه غلیظ (عدسی زرد خالص) گزینه‌ای تخصصی‌تر هستند.</p>"}, "elements": []}]}, {"id": "c92b3ad", "elType": "container", "settings": {"_title": "تفاوت اصلی گاگل ایمنی با عینک آفتابی معمولی در چیست؟", "content_width": "full"}, "elements": [{"id": "d1f1253", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align:justify;\">عینک‌های معمولی در اثر اصابت توپ یا آرنج خرد می‌شوند و خرده‌های آن تهدید جدی برای چشم است. گاگل‌های ایمنی طبق استانداردهایی چون ASTM F803 آزمایش می‌شوند، دارای فریم پددار جاذب ضربه، عدسی نشکن و بند کشی الاستیک هستند.</p>"}, "elements": []}]}, {"id": "5cc4c9f", "elType": "container", "settings": {"_title": "چگونه از بخار گرفتن عدسی عینک حین تعریق زیاد جلوگیری کنیم؟", "content_width": "full"}, "elements": [{"id": "3b4c438", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"text-align:justify;\">۱) انتخاب فریم‌هایی با دریچه‌های تهویه هوا، ۲) استفاده از پوشش درونی ضدبخار (Anti-Fog) پایدار، و ۳) تنظیم صحیح پد بینی تا عینک فاصله اندکی با صورت داشته باشد و گردش هوا قطع نگردد.</p>"}, "elements": []}]}]}]}, {"id": "b7ed16f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "\n<div class=\"av-summary-box\">\n    <h2 style=\"color:#166534;font-size:1.45rem;margin-top:0;margin-bottom:14px;\">جمع‌بندی و نتیجه‌گیری</h2>\n    <p style=\"color:#14532d;font-size:1.05rem;line-height:1.9;margin-bottom:16px;text-align:justify;\">به عنوان متخصصی که سال‌ها میان فریم‌ها، عدسی‌ها و نیازهای مختلف ورزشکاران فعالیت داشته‌ام، یک اصل را بارها تجربه کرده‌ام:</p>\n    <div style=\"background:#fff;border-radius:12px;padding:16px;border:1px solid #bbf7d0;margin-bottom:16px;\">\n        <ul style=\"margin:0;padding-right:20px;color:#166534;line-height:1.9;\">\n            <li><strong>بهترین عینک ورزشی</strong> لزوماً گران‌ترین گزینه نیست؛ بلکه مدلی است که با ارگونومی چهره، نوع ورزش و نیاز بینایی شما هماهنگ باشد.</li>\n            <li><strong>دورپیچ و یک تکه</strong> برای دویدن و دوچرخه‌سواری در فضای باز، <strong>گاگل ایمنی</strong> برای ورزش‌های برخوردی توپی، <strong>گاگل اسکی و شنا</strong> برای محیط‌های آبی و برفی، و <strong>عینک طبی ورزشی</strong> برای ورزشکاران نمره‌دار.</li>\n        </ul>\n    </div>\n    <p style=\"margin:0;color:#15803d;font-weight:bold;font-size:1.05rem;\">⚡ انتخاب درست، ارزش واقعی خود را در اولین برخورد غیرمنتظره توپ یا اولین مسیر پرنور و ناهموار به شما اثبات خواهد کرد.</p>\n</div>\n"}, "elements": []}]}]